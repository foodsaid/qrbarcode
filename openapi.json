{
  "openapi": "3.0.3",
  "info": {
    "title": "二维码 / 条形码生成服务",
    "description": "QR code & Code128 barcode generation API · 直接返回 PNG 图片，可用于网页、报表和打印。\n\n| 用途 | 请求 |\n|---|---|\n| 二维码（默认） | `GET /generate?content=Hello` |\n| 条形码 Code128 | `GET /generate?content=ABC-123&type=barcode` |\n\n限流 Rate limit：每个客户端 IP 每分钟 50 次 `/generate`，超出返回 `429`。\n\n---\n© 2026 foodsaid · MIT License · 文档界面基于 Swagger UI (Apache-2.0)，第三方许可见 [NOTICE](/static/vendor/swagger-ui-5.33.1/NOTICE)\n\nQR Code 是 DENSO WAVE INCORPORATED 的注册商标 · QR Code is a registered trademark of DENSO WAVE INCORPORATED.",
    "version": "set at runtime from main.__version__"
  },
  "tags": [
    {
      "name": "generate",
      "description": "生成二维码与条形码 · Generate codes"
    },
    {
      "name": "health",
      "description": "健康检查与运行状态 · Health & metrics"
    }
  ],
  "paths": {
    "/generate": {
      "get": {
        "tags": [
          "generate"
        ],
        "summary": "生成二维码或条形码 · Generate a QR code or barcode",
        "operationId": "generateCode",
        "parameters": [
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "要编码的内容 · Text to encode\n- 二维码 QR code：最多 1000 个字符，支持任意文本（含中文）\n- 条形码 Barcode：最多 64 个字符，仅限 ASCII，可含 `-` `.` `@` `#` 等符号",
            "schema": {
              "type": "string",
              "maxLength": 1000
            },
            "example": "Hello World"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "类型（不区分大小写） · Code type (case-insensitive)",
            "schema": {
              "type": "string",
              "enum": [
                "qrcode",
                "barcode"
              ],
              "default": "qrcode"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG 图片 · PNG image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "description": "返回 PNG 图片。中文等非 ASCII 内容请使用二维码。\n\nReturns a PNG image. Use a QR code for non-ASCII text such as Chinese."
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "健康检查 · Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "服务正常 · Service is healthy",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "example": "OK"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "运行状态与限流配置 · Service metrics",
        "operationId": "metrics",
        "responses": {
          "200": {
            "description": "服务指标 · Service metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metrics"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Metrics": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "version": {
            "type": "string",
            "example": "0.1.4"
          },
          "config": {
            "type": "object",
            "properties": {
              "max_content_length": {
                "type": "integer",
                "example": 1000
              },
              "rate_limit": {
                "type": "string",
                "description": "Global rate limit, or \"disabled\"",
                "example": "100 per minute"
              },
              "allowed_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "qrcode",
                    "barcode"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "参数错误 · Invalid input parameters",
        "content": {
          "text/html": {
            "schema": {
              "type": "string",
              "example": "Missing 'content' parameter"
            }
          }
        }
      },
      "RateLimited": {
        "description": "请求过于频繁 · Rate limit exceeded",
        "content": {
          "text/html": {
            "schema": {
              "type": "string",
              "example": "Rate limit exceeded. Please try again later."
            }
          }
        }
      },
      "InternalError": {
        "description": "服务器内部错误 · Internal server error",
        "content": {
          "text/html": {
            "schema": {
              "type": "string",
              "example": "Internal server error"
            }
          }
        }
      }
    }
  }
}
